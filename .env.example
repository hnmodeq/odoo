# Optional overrides for docker-compose.yml / docker-compose.try.yml
#
# Copy to ".env" (same directory) and adjust:
#     cp .env.example .env
#
# A .env file is NOT required — the compose files fall back to the
# defaults shown here. Create one at least to change the passwords
# before using Odoo for anything real.
#
# IMPORTANT: POSTGRES_USER / POSTGRES_PASSWORD are only applied the
# FIRST time the database volume is created. If you change DB_USER
# or DB_PASSWORD afterwards, Odoo will fail with
# "password authentication failed" (-> Internal Server Error in the
# browser) until you either change them back or reset the volume:
#     docker compose down -v      # WARNING: deletes all data

# PostgreSQL user Odoo connects with (created on first init).
DB_USER=odoo
# PostgreSQL password. CHANGE ME.
DB_PASSWORD=odoo

# Odoo "master password" — asked when creating/managing databases
# at http://localhost:8069/web/database/manager . CHANGE ME.
# (This is NOT your login password; you choose your own admin
#  login e-mail + password on the database-creation screen.)
ADMIN_PASSWORD=admin

# Host ports (change if 8069/8072 are already in use).
ODOO_PORT=8069
ODOO_GEVENT_PORT=8072
